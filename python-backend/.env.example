# 应用配置
APP_NAME=AI评测平台
APP_DEBUG=true
APP_PORT=9090

# OpenRouter 配置（调用大模型 API 所需）
OPENROUTER_API_KEY=your-openrouter-api-key-here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OpenRouter HTTP 代理（本地 Clash 等）；留空则直连
OPENROUTER_HTTP_PROXY=http://127.0.0.1:7890

# AiHubMix 配置（双平台模型库）
AIHUBMIX_API_KEY=your-aihubmix-api-key-here
# 对话 / OpenAI SDK（官方文档：https://aihubmix.com/v1）
AIHUBMIX_BASE_URL=https://aihubmix.com/v1
# 模型列表（官方文档：https://aihubmix.com/api/v1/models）
AIHUBMIX_MODELS_URL=https://aihubmix.com/api/v1

# Session/加密密钥（生产环境务必修改）
SECRET_KEY=your-secret-key-here

# 数据库配置
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=11111111
DB_NAME=ai_eval

# Redis 配置
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# CORS 配置
CORS_ORIGINS=http://localhost:5173,http://localhost:8080

# K-12 口语练习评测（Step2）
# 本地发音评测 HTTP 服务（provider=http 时使用），POST {baseUrl}/score
PRONUNCIATION_EVAL_URL=
# 内置统一评测 MultiPA + APG-MOS（provider=unified，默认启用）
UNIFIED_EVAL_ENABLED=true
UNIFIED_EVAL_DIR=/root/unified-speech-eval
MULTIPA_DIR=/root/my_image_files/口语练习评测/MultiPA
APG_MOS_DIR=/root/autodl-tmp/APG-MOS
# 留空则使用 {MULTIPA_DIR}/.venv/bin/python
MULTIPA_PYTHON=
UNIFIED_EVAL_TIMEOUT_SEC=3600
# 启动时拉起 MultiPA/APG 常驻进程（评测仅走 daemon，无 subprocess 回退）
MULTIPA_DAEMON_PORT=18765
APG_DAEMON_PORT=18766
# 首次启动模型加载可能较久（秒）
UNIFIED_EVAL_DAEMON_WARMUP_SEC=600
# MultiPA 与 APG-MOS daemon 并行请求（默认 true，可缩短总耗时；GPU 紧张时可设 false）
UNIFIED_EVAL_PARALLEL_DAEMON=true
# 内容 Judge 默认模型（openrouter: 或 aihubmix: 前缀）
# 内容三维评测 Judge（建议 gpt-4o 级模型，与 gpt_eval_new_dimensions.py 一致）
ORAL_EVAL_JUDGE_MODEL=aihubmix:gemini-3.1-flash-lite
# 可选：覆盖默认 K-12 教师 system prompt
ORAL_EVAL_DEFAULT_SYSTEM_PROMPT=
# 内容评测内置题库（默认 my_version/data/questiontext）
# CONTENT_EVAL_QUESTION_DIR=
CONTENT_EVAL_MAX_FILES_PER_JOB=200

# 口语回复生成（内置 questionwav + API 教师模式）
ORAL_GEN_QUESTIONWAV_DIR=/root/autodl-tmp/questionwav
ORAL_GEN_OUTPUT_ROOT=/tmp/oral_gen_output
ORAL_GEN_MAX_SAMPLES_PER_JOB=200
ORAL_GEN_REQUEST_INTERVAL_SEC=1.0
ORAL_GEN_JOB_WORKERS=1
